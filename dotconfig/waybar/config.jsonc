{
    "layer": "top",
    "height": 34,
    "spacing": 8,

    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "niri/window"
    ],

    // Displayed right to left: shutdown, time, battery, wifi, sound.
    "modules-right": [
        "group/right"
    ],

    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "wireplumber",
            "network",
            "battery",
            "clock",
            "custom/shutdown"
        ]
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "\uF111",
            "active": "\uF111",
            "urgent": "\uF06A",
            "empty": "\uF10C",
            "default": "\uF10C"
        }
    },

    "niri/window": {
        "max-length": 80
    },

    "custom/shutdown": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "systemctl poweroff",
        "on-click-right": "systemctl reboot"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "network": {
        "format-wifi": "\uF1EB  {essid}",
        "format-ethernet": "\uF1E0",
        "format-disconnected": "\uF071",
        "tooltip-format": "{ifname} — {essid} ({signalStrength}%)"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "\uF026",
        "format-icons": ["\uF027", "\uF027", "\uF028"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "\uF1E6 {capacity}%",
        "format-plugged": "\uF1E6 {capacity}%",
        "format-icons": ["\uF244", "\uF243", "\uF242", "\uF241", "\uF240"],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{capacity}% — {timeTo}"
    }
}
